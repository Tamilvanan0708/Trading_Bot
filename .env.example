# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Market Configuration
DEFAULT_SYMBOL=XAUUSD
LOT_CONTRACT_SIZE=100.0  # 100 troy oz for standard XAU/USD lot
PIP_SIZE=0.1             # Gold 1 pip = 0.10 or 0.01 depending on broker, base point is 0.01

# Risk Management
RISK_PERCENT=1.0         # 1% per trade
MAX_RISK_PERCENT=3.0     # Hard safety limit
MAX_OPEN_TRADES=3
ACCOUNT_BALANCE=10000.0  # Default initial paper balance
MIN_RISK_REWARD=1.5      # Minimum R:R for a signal to earn R:R confluence points
MAX_TOTAL_DRAWDOWN_PCT=30  # Auto-pause paper trading at 30% account drawdown

# ATR & Volatility
ATR_PERIOD=14            # ATR smoothing period
ATR_FALLBACK=2.5         # Fallback ATR if market data is insufficient

# Confluence & Strategy Weights (Sum to 100)
WEIGHT_HTF_BIAS=20
WEIGHT_MARKET_STRUCTURE=20
WEIGHT_SMC_CONFIRMATION=20
WEIGHT_FIB_CONFIRMATION=15
WEIGHT_LIQUIDITY=10
WEIGHT_ENTRY_CONFIRMATION=10
WEIGHT_RISK_REWARD=5

# Signal Thresholds
THRESHOLD_VERY_STRONG=90
THRESHOLD_STRONG=75
THRESHOLD_MODERATE=60
THRESHOLD_WEAK=40

# AI Validation Configuration
# AI_PROVIDER: mock (heuristic only) | auto (chain) | groq | gemini | openrouter | ollama | bai | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.1

# Multi-provider AI validation (free providers first)
# Set keys for any/all to enable the corresponding provider.
# The chain priority is: Groq → Gemini → OpenRouter → Ollama → BAI → UNAVAILABLE
# 402 (Insufficient Balance) is never retried.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-qwen-32b:free
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b
BAI_API_KEY=
# NOTE: B.AI does NOT offer `gpt-4o-mini`.  Valid OpenAI-family model IDs are
# GPT-5.x, e.g. `gpt-5-4-mini` (compact) or `gpt-5-mini`.  An unsupported model
# name makes B.AI return HTTP 400 "Invalid request body".
BAI_MODEL=gpt-5-4-mini
BAI_BASE_URL=https://api.b.ai/v1

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Paper Trading
PAPER_TRADING_ENABLED=true
AUTO_TRADE_ON_CAUTION=false  # Open paper trade on AI CAUTION (not only APPROVE)

# Safety
OBSERVATION_MODE=false                       # true = signals only, never open paper trades
BLOCK_PAPER_TRADING_ON_FAILED_STRATEGY=true  # block auto paper trading while strategy classified FAILED
# REAL_MONEY_EXECUTION is not configurable: real-money execution is permanently
# disabled and there is no broker order API in the codebase.

# Research signal limits
MAX_SIGNALS_PER_DAY=0            # 0 = unlimited; cap tradable signals per UTC day
COOLDOWN_AFTER_LOSS_MINUTES=0    # 0 = off
CANDIDATE_TELEGRAM_ALERTS_ENABLED=false  # Telegram alerts for Candidate A/B/C forward signals

# Dashboard
DASHBOARD_REFRESH_SECONDS=30

# Security
# CORS_ALLOW_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Only set to ["*"] for non-authenticated local/LAN use (credentials are then disabled).

# MetaTrader 5 Bridge
MT5_ENABLED=false
MT5_LOGIN=0
MT5_SERVER=
MT5_PASSWORD=
MT5_MAGIC=0
MT5_SYMBOL=XAUUSD
MT5_TZ_OFFSET_MINUTES=0

# Live Market Feed (mock | binance | ctrader | tradingview)
LIVE_FEED_PROVIDER=mock
BINANCE_WS_URL=wss://fstream.binance.com/stream
BINANCE_REST_BASE_URL=https://fapi.binance.com
BINANCE_HISTORY_TIMEOUT_SECONDS=15
BINANCE_HISTORY_MAX_RETRIES=3
BINANCE_HISTORY_RETRY_BACKOFF=2.0
LIVE_HISTORY_MAX_AGE_MINUTES=30
LIVE_HISTORY_MIN_CANDLES=50
MAX_CANDLE_GAP_COUNT=5
LIVE_HISTORY_REFRESH_INTERVAL_MINUTES=15
LIVE_HISTORY_REFRESH_ON_DEGRADED=true
LIVE_HISTORY_REFRESH_LOOKBACK_HOURS=48
LIVE_HISTORY_EMERGENCY_REFRESH_COOLDOWN_SECONDS=60
CTRADER_WS_URL=wss://connect.spotware.com/apps/
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=0
CTRADER_SYMBOL_ID=0
TICK_RING_BUFFER_CAPACITY=10000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/xauusd_agent.db
